	"scripts": {
		"prepare": "svelte-kit sync || echo ''",
		"dev": "electron-forge start",
		"start": "electron-forge start",
		"build": "vite build",
		"package": "electron-forge package",
		"make": "pnpm build && electron-forge make",
		"publish": "electron-forge publish",
		"release": "tsx scripts/release.ts",
		"release:patch": "tsx scripts/release.ts patch",
		"release:minor": "tsx scripts/release.ts minor",
		"release:major": "tsx scripts/release.ts major",
		"release:to": "tsx scripts/release.ts to",
		"release:beta": "tsx scripts/release.ts beta",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint . --cache",
		"lint:fix": "eslint . --fix --cache",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"quality": "npm run check && npm run lint && npm run format:check",
		"quality:fix": "npm run lint:fix && npm run format",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"generate:ipc": "tsx scripts/generate-ipc.ts",
		"gen:service": "tsx scripts/generate.ts service",
		"gen:state": "tsx scripts/generate.ts state",
		"postinstall": "pre-commit install --install-hooks --hook-type commit-msg"
	},
